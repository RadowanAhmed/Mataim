# Supabase (mobile)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Payments server (add service role from Supabase dashboard — never commit real key to git)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
PAYMENTS_CORS_ORIGINS=http://localhost:8081,http://10.0.2.2:8081

# Android Client ID
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id_here

# iOS Client ID
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id_here

# Web Client ID (for Supabase)
GOOGLE_WEB_CLIENT_ID=your_google_web_client_id_here

# Web Client Secret
GOOGLE_WEB_CLIENT_SECRET=your_google_web_client_secret_here

EXPO_PUBLIC_API_URL=http://10.0.2.2:4000
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# backend/.env
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
PORT=4000